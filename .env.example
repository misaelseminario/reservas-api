# Variables de entorno de reservas-api.
# Copia este archivo a `.env` y rellena los valores. `.env` NUNCA se versiona.

# Clave secreta para firmar los JWT (obligatoria, sin valor por defecto).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Algoritmo de firma de los JWT.
ALGORITHM=HS256

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL de la base de datos (SQLite en un archivo local).
DATABASE_URL=sqlite:///./reservas.db
